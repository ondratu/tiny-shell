# Strict, with the checks that do not fit this project switched off. Every
# switched off check has a reason; revisit them when the reason is gone.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  cert-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-avoid-c-arrays,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-named-parameter,
  -performance-enum-size,
  -modernize-macro-to-enum,
  -cert-dcl50-cpp,
  -modernize-avoid-variadic-functions,
  -misc-multiple-inheritance,
  -bugprone-throwing-static-initialization,
  -cert-err58-cpp,
  -misc-use-internal-linkage,
  -misc-use-anonymous-namespace,
  -cert-err33-c,
  -bugprone-macro-parentheses,
  -readability-avoid-return-with-void-value,
  -modernize-pass-by-value,
  -modernize-use-default-member-init,
  -modernize-min-max-use-initializer-list,
  -readability-convert-member-functions-to-static,
  -readability-function-cognitive-complexity,
  -readability-uppercase-literal-suffix
# Disabled because:
#  performance-enum-size, modernize-macro-to-enum
#                                         (enums are flag sets given to X)
#  cert-dcl50-cpp, modernize-avoid-variadic-functions
#                                         (printf-style log(); checked with the
#                                          format attribute)
#  misc-multiple-inheritance              (Client, see the TODO)
#  bugprone-throwing-static-initialization, cert-err58-cpp
#                                         (the global theme, see the TODO)
#  misc-use-internal-linkage, misc-use-anonymous-namespace
#                                         (static is the convention here)
#  cert-err33-c                           (the result of fprintf to stderr)
#  bugprone-macro-parentheses             (macros of theme.cc take a name)
#  readability-avoid-return-with-void-value
#                                         (return error("...") in void functions)
#  modernize-pass-by-value, modernize-use-default-member-init,
#  modernize-min-max-use-initializer-list
#                                         (style; constructors initialize)
#  readability-convert-member-functions-to-static
#                                         (event handlers are member pointers)
#  bugprone-easily-swappable-parameters  (x, y, width, height are the X API)
#  bugprone-reserved-identifier, cert-dcl37-c, cert-dcl51-cpp
#                                         (atoms are named _NET_WM_STATE ...)
#  misc-include-cleaner                  (X11 headers define things everywhere)
#  misc-non-private-member-variables-in-classes
#                                         (the toolkit keeps public state; the
#                                          TODO plans to reduce it)
#  modernize-use-trailing-return-type, modernize-use-nodiscard
#                                         (style, not a defect)
#  modernize-avoid-c-arrays               (X structures need C arrays)
#  portability-avoid-pragma-once          (CONTRIBUTING.md chooses #pragma once)
#  readability-identifier-length          (x, y, w, h, e, dsp are clear here)
#  readability-implicit-bool-conversion   (Xlib returns int as bool)
#  readability-magic-numbers              (pixel sizes of the drawing code)
#  readability-uppercase-literal-suffix  (0u and 1u are fine)
#  readability-math-missing-parentheses, readability-named-parameter,
#  readability-function-cognitive-complexity
#                                         (style; revisit with the cleanup)
HeaderFilterRegex: '(lib|src|tests)/.*'
WarningsAsErrors: '*'
